# Copy to backend/.env for local development. All values are optional locally.

# PostgreSQL in production, e.g. a free Neon database:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./shotsense.db

# Required in production. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Frontend origins allowed to call the API (only needed when the frontend is hosted separately).
CORS_ORIGINS=http://localhost:5173

# LLM for shot breakdowns. Leave both empty to use the built-in templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_VISION=true

# Optional shared demo account shown on the sign-in page.
DEMO_EMAIL=
DEMO_PASSWORD=

MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=600
MAX_SHOTS=60
