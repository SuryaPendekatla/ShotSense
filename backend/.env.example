# Copy to backend/.env for local development. All values are optional locally.

# PostgreSQL in production, e.g. a free Neon database:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./shotsense.db

# Required in production. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Frontend origins allowed to call the API (only needed when the frontend is hosted separately).
CORS_ORIGINS=http://localhost:5173

# LLM for shot breakdowns. Leave both empty to use the built-in templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_VISION=true

# One-time demo ("Try the demo" on the sign-in page): a private guest account with a small quota.
# The same browser or internet connection can start one demo per GUEST_IP_WINDOW_HOURS.
GUEST_ENABLED=true
GUEST_MAX_ANALYSES=3
GUEST_SESSION_HOURS=24
GUEST_IP_WINDOW_HOURS=720

MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=600
MAX_SHOTS=60
